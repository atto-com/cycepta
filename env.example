# Cycepta environment — copy to .env and edit. run.sh sources it on start.
# All values below are defaults unless stated otherwise.

# --- Ports ---
NCD_PORT=5000
API_PORT=5001

# --- NCD engine (see QUICK_START.md for the full table) ---
# Diff-heatmap instead of the absolute density map
NCD_USE_DIFF=1
# Garbage classifier on ingest (0 disables it and lowers memory use)
NCD_JUDGE=1
# UMAP refit cadence in periods; 0 = fit once and keep coordinates stable
NCD_UMAP_REFIT_INTERVAL=0
# Deterministic layout: the same stream must produce the same concepts
NCD_UMAP_RANDOM_STATE=42
NCD_UMAP_N_JOBS=1
# Single-threaded numba is required on Apple Silicon (UMAP segfaults otherwise)
NUMBA_NUM_THREADS=1

# Bind address: 127.0.0.1 is the safe default; use 0.0.0.0 only behind a
# reverse proxy/firewall.
NCD_BIND_HOST=127.0.0.1
# Comma-separated browser origins allowed to call the NCD service directly
NCD_CORS_ORIGINS=http://localhost:5001,http://127.0.0.1:5001

# --- API security ---
# Shared secret for POST /api/v1/ingest. Empty = no key (fine on localhost).
THREAT_INGEST_KEY=
# Allow RSS sources on private/loopback networks (intranet feeds). Keep 0
# unless you intentionally run an internal feed; otherwise it is an SSRF hole.
THREAT_ALLOW_PRIVATE_FEEDS=0
# Browser origins allowed to call the .NET API (comma-separated).
# Cors__AllowedOrigins=http://localhost:5001,http://127.0.0.1:5001

# --- Local summarization model (optional; weights are not shipped) ---
# Model directory with safetensors, relative to ncdbody/ or absolute.
NCD_LLM_MODEL=models/granite-4.0-1b
# auto | transformers | mlx | none
NCD_LLM_BACKEND=transformers
# auto | mps | cuda | cpu  (auto prefers CUDA, then MPS, then CPU)
NCD_LLM_DEVICE=auto
# auto | bfloat16 | float16 | float32  (auto = bf16 on accelerators, fp32 on CPU)
NCD_LLM_DTYPE=auto
# none | int4 (torchao; roughly 3x less LLM memory on MPS/CUDA)
NCD_LLM_QUANT=none

# --- Report summarization (Granite 4.0 1B) ---
# Prompt window available to the model. Items are summarized in batches of 8,
# so real prompts stay far below this ceiling even on 8 GB machines.
NCD_LLM_CTX=4096
# Hard output budget. Each item batch requests at most 360 tokens.
NCD_LLM_MAX_TOKENS=1024
# 0.3 keeps item summaries fluent; 0 = greedy and reproducible.
NCD_LLM_TEMPERATURE=0.3
NCD_LLM_TOP_P=0.95
NCD_LLM_TOP_K=50
# 1.0 disables the repetition penalty.
NCD_LLM_REPETITION_PENALTY=1.05
# Only providers declared in ncdbody/llm_providers.yaml may be called. Set to 1
# to allow an arbitrary http(s) base_url from the summarize request (SSRF risk).
NCD_ALLOW_CUSTOM_LLM_ENDPOINT=0

# --- API LLM providers ---
# Keys for the api entries in ncdbody/llm_providers.yaml (key_env names).
# Leave empty to type the key in the dashboard instead; it is never stored.
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
